{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prismagram",
  "version": "0.4.0",
  "identifier": "io.github.kingvic300.prismagram",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prismagram",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Prisma schema to UML class diagram",
    "longDescription": "Prismagram reads Prisma schema files and renders them as clean UML class diagrams you can export to SVG or PNG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QUY0NjVEQ0FGRThDMDUKUldRRmpQN0tYVWF2YVNxcVg3MjBMMkFBMWFURzNwZ2d1dFZFVnJFSnhGcXV5MEd1ZEdmZnMrVCsK",
      "endpoints": [
        "https://github.com/Kingvic300/Prismagram/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
